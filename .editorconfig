# Convenciones de formato comunes a los tres equipos.
# https://editorconfig.org  ·  VS Code las aplica con la extension EditorConfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.java]
indent_size = 4
max_line_length = 120

[*.{gradle,kts}]
indent_size = 4

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.md]
# En Markdown dos espacios al final significan salto de linea.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
