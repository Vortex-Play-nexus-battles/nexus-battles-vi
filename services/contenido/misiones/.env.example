# Plantilla de configuracion del servicio de misiones (regla 10 de plataforma:
# solo variables de entorno, ningun valor real versionado). Copiar a .env y
# completar; .env esta ignorado por git. Cada variable esta explicada en
# src/main/resources/application.properties y en el README.

# Puerto HTTP dentro del contenedor.
PUERTO_MISIONES=8080

# Base documental propia (regla 7: ningun otro servicio la lee).
MONGODB_URI=mongodb://localhost:27017/misiones

# Emisor de los tokens de jugador (ms-identidad, ADR-002/ADR-005).
IDENTIDAD_JWKS_URL=http://localhost:8089/api/v1/auth/jwks

# Credencial de servicio de misiones (client_credentials contra ms-identidad).
# El secreto lo reparte el despliegue; nunca se escribe aqui.
DIRECTORIO_ACTIVO_URL=http://localhost:8089/api/v1/auth/token
DIRECTORIO_ACTIVO_CLIENT_ID=misiones
DIRECTORIO_ACTIVO_CLIENT_SECRET=

# Dependencias (REST sincrono).
HEROES_BASE_URL=http://localhost:8101
INVENTARIO_BASE_URL=http://localhost:8102
PRODUCTOS_BASE_URL=http://localhost:8103
MOTOR_COMBATE_URL=http://localhost:8104
CREDITOS_URL=http://localhost:8093/api/v1
CORREO_URL=http://localhost:8082/api/v1
NOTIFICACIONES_URL=http://localhost:8085/api/v1
IDENTIDAD_URL=http://localhost:8089

# Reloj y trabajo en segundo plano. 3600 = una hora de mision es una hora real.
MISIONES_SEGUNDOS_POR_HORA=3600
MISIONES_INTERVALO_MS=30000
MISIONES_LOTE=20
MISIONES_REINTENTO_SEGUNDOS=30
MISIONES_CORREO_ACTIVO=true
MISIONES_AVISOS_ACTIVO=true

# Solo banco E2E y desarrollo: publica la semilla PROVISIONAL DE DEV y fija el azar.
MISIONES_SEMILLA_PROVISIONAL=false
MISIONES_SEMILLA_DE_PRUEBAS=

# Decisiones del PO pendientes (vacio o 0 = valor provisional del README).
MISIONES_XP_COMPLETAR_FACIL=0
MISIONES_XP_COMPLETAR_NORMAL=0
MISIONES_XP_COMPLETAR_DIFICIL=0
MISIONES_XP_COMPLETAR_EXTREMO=0
MISIONES_CREDITOS_HEROICO=
MISIONES_CREDITOS_LEGENDARIO=
MISIONES_CREDITOS_MITICO=
MISIONES_MULTIPLICADOR_MITICO=
MISIONES_EPICA_EXIGE_COMPLETAR=false
