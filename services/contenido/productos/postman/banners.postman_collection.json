{
  "info": {
    "name": "HU-PRD-013 - Banners",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear banner",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contenido\": \"Torneo especial de Nexus Battles\",\n  \"publicarDesde\": \"2099-01-01T00:00:00Z\",\n  \"vigenteHasta\": \"2099-01-02T00:00:00Z\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/banners"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Creado', () => pm.response.to.have.status(201));",
              "pm.environment.set('bannerId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Listar para administracion",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/banners"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lista administrativa', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Consultar vigentes sin token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/banners/vigentes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Consulta publica', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Editar banner",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contenido\": \"Torneo especial actualizado\",\n  \"publicarDesde\": \"2099-01-01T00:00:00Z\",\n  \"vigenteHasta\": \"2099-01-03T00:00:00Z\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/banners/{{bannerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Editado', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Retirar banner",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/v1/banners/{{bannerId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Retirado', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}
