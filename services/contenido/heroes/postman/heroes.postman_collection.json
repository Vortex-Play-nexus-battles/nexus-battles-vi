  {
   "name": "1. HU-HER-001 Seleccion de heroe (catalogo)",
   "item": [
    {
     "name": "Catalogo: los prototipos de la Tabla 5",
     "request": {
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/heroes"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const catalogo = pm.response.json();",
         "pm.test('responde 200 JSON', () => { pm.response.to.have.status(200); pm.response.to.be.json; });",
         "pm.test('trae los 8 prototipos iniciales de la Tabla 5 (sin fijar la cantidad: acta 13-ago)', () => {",
         "  const nombres = catalogo.map(h => h.nombre);",
         "  ['Guerrero Tanque','Guerrero Armas','Mago Fuego','Mago Hielo','Pícaro Veneno','Pícaro Machete','Chamán','Médico'].forEach(n => pm.expect(nombres).to.include(n));",
         "});",
         "pm.test('cada entrada tiene nombre, tipo y esSanador (criterio 1)', () => {",
         "  catalogo.forEach(h => { pm.expect(h).to.have.all.keys('nombre','tipo','esSanador'); });",
         "});",
         "pm.test('exactamente dos sanadores: Chaman y Medico (Tabla 6)', () => {",
         "  pm.expect(catalogo.filter(h => h.esSanador).map(h => h.nombre).sort()).to.eql(['Chamán','Médico']);",
         "});"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "2. HU-HER-002 Estadisticas base (ficha)",
   "item": [
    {
     "name": "Ficha del Guerrero Tanque: ejemplo del cliente en clase (RG-015)",
     "request": {
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/heroes/Guerrero Tanque"
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const f = pm.response.json();",
         "pm.test('responde 200', () => pm.response.to.have.status(200));",
         "pm.test('Tabla 6: poder 10, vida 44, defensa 11', () => {",
         "  pm.expect(f.estadisticasNivel1.poder).to.eql(10);",
         "  pm.expect(f.estadisticasNivel1.vida).to.eql(44);",
         "  pm.expect(f.estadisticasNivel1.defensa).to.eql(11);",
         "});",
         "pm.test('Tabla 6: ataque 10 + 1d6, dano 1d4 (texto)', () => {",
         "  pm.expect(f.estadisticasNivel1.ataque).to.eql('10 + 1d6');",
         "  pm.expect(f.estadisticasNivel1.dano).to.eql('1d4');",
         "});",
         "pm.test('formula estructurada para el motor: ataqueDetalle 10/1/6, danoDetalle 0/1/4', () => {",
         "  pm.expect(f.estadisticasNivel1.ataqueDetalle).to.eql({base:10, cantidadDados:1, caras:6});",
         "  pm.expect(f.estadisticasNivel1.danoDetalle).to.eql({base:0, cantidadDados:1, caras:4});",
         "});",
         "pm.test('un no sanador no trae sanar', () => pm.expect(f.estadisticasNivel1).to.not.have.property('sanar'));",
         "pm.test('tres acciones exactas de la Tabla 7', () => {",
         "  pm.expect(f.acciones).to.have.lengthOf(3);",
         "  pm.expect(f.acciones[0].nombre).to.eql('Golpe con escudo');",
         "});",
         "pm.test('descripcion textual de la Tabla 5', () => pm.expect(f.descripcion).to.include('alta resistencia'));"
        ]
       }
      }
     ]
    },
