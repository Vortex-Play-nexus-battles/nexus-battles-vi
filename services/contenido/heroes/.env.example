# Plantilla de configuracion del servicio de heroes (regla 10 de plataforma:
# solo variables de entorno, ningun valor real versionado). Copiar a .env y
# completar; .env esta ignorado por git.

# Puerto HTTP del servicio (por defecto 8080)
PUERTO_HEROES=8080

# Perfiles de Spring. Sin "mongo" el catalogo vive en memoria (demo/pruebas).
SPRING_PROFILES_ACTIVE=mongo

# URI de MongoDB 8 del servicio. Un esquema/base por servicio (regla 7):
# ningun otro servicio accede a esta base.
MONGODB_URI=mongodb://usuario:clave@localhost:27017/heroes?authSource=admin
