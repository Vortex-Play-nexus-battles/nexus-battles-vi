{
  "info": {
    "name": "Servicio de inventario - HU-INV-003 y HU-INV-005",
    "_postman_id": "7c1e4b02-inventario-inv-003-005",
    "description": "Validacion contra el servicio en ejecucion de HU-INV-003 (creacion y edicion de elementos propios, propiedad, 403 sobre inventario ajeno) y HU-INV-005 (equipamiento con limites: dos armas, seis partes de armadura, dos items). Las peticiones estan encadenadas: cada una guarda los identificadores que usan las siguientes, asi que se corre la coleccion completa y en orden (Run collection o Newman). La identidad viaja en X-User-Name, la convencion temporal hasta HU-AUT-004.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
      "if (!pm.collectionVariables.get('jugadorA')) {",
      "  const sufijo = Date.now();",
      "  pm.collectionVariables.set('jugadorA', 'jugador-a-' + sufijo);",
      "  pm.collectionVariables.set('jugadorB', 'jugador-b-' + sufijo);",
      "}"
    ] } }
  ],
  "item": [
    {
      "name": "1. HU-INV-003 Creacion y edicion de elementos propios",
      "item": [
        {
          "name": "Sin identidad no se puede crear (401)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/inventario/elementos",
            "body": { "mode": "raw", "raw": "{\"productoId\":\"prototipo-guerrero-tanque\",\"tipo\":\"HEROE\",\"nombrePropio\":\"Sin dueno\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('responde 401', () => pm.response.to.have.status(401));",
            "pm.test('formato de error estandar (RFC 9457)', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
            "pm.test('titulo Identidad requerida', () => pm.expect(pm.response.json().title).to.eql('Identidad requerida'));"
          ] } }]
        },
        {
          "name": "A crea su heroe (201)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-User-Name", "value": "{{jugadorA}}" }],
            "url": "{{baseUrl}}/api/v1/inventario/elementos",
            "body": { "mode": "raw", "raw": "{\"productoId\":\"prototipo-guerrero-tanque\",\"tipo\":\"HEROE\",\"nombrePropio\":\"Mi tanque\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const e = pm.response.json();",
            "pm.test('responde 201', () => pm.response.to.have.status(201));",
            "pm.test('Location apunta al elemento creado', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/inventario/elementos/' + e.id));",
            "pm.test('el elemento queda con id, producto, tipo y nombre', () => {",
            "  pm.expect(e.id).to.be.a('string').that.is.not.empty;",
            "  pm.expect(e.productoId).to.eql('prototipo-guerrero-tanque');",
            "  pm.expect(e.tipo).to.eql('HEROE');",
            "  pm.expect(e.nombrePropio).to.eql('Mi tanque');",
            "});",
            "pm.collectionVariables.set('heroeId', e.id);"
          ] } }]
        },
        {
          "name": "A renombra su heroe (200): el cambio queda persistido",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-User-Name", "value": "{{jugadorA}}" }],
            "url": "{{baseUrl}}/api/v1/inventario/elementos/{{heroeId}}",
            "body": { "mode": "raw", "raw": "{\"nombrePropio\":\"Tanque de Cesar\"}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('responde 200', () => pm.response.to.have.status(200));",
            "pm.test('nombre modificado', () => pm.expect(pm.response.json().nombrePropio).to.eql('Tanque de Cesar'));"
          ] } }]
        },
        {
          "name": "La vitrina de A refleja el cambio (HU-INV-001, pagina de 16)",
          "request": { "method": "GET", "header": [{ "key": "X-User-Name", "value": "{{jugadorA}}" }], "url": "{{baseUrl}}/api/v1/inventario/elementos" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const p = pm.response.json();",
            "pm.test('responde 200', () => pm.response.to.have.status(200));",
            "pm.test('pagina de dieciseis', () => pm.expect(p.tamanio).to.eql(16));",
            "pm.test('el heroe renombrado aparece en la vitrina', () => {",
            "  const h = p.elementos.find(x => x.id === pm.collectionVariables.get('heroeId'));",
            "  pm.expect(h).to.not.be.undefined; pm.expect(h.nombrePropio).to.eql('Tanque de Cesar');",
