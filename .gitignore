# ============================================
# The Nexus Battles VI - Empresa A
# .gitignore base, independiente del lenguaje.
# La Fase 2 anadira las secciones del stack elegido.
# ============================================

# --- Secretos y configuracion local (CRITICO) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials.json
secrets.yml
secrets.yaml

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores e IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Artefactos de compilacion y dependencias ---
.gradle/
build/
build.nosync/
dist/
out/
target/
bin/
obj/
node_modules/
__pycache__/
*.pyc
*.class
*.jar
*.war

# --- Logs y temporales ---
logs/
*.log
tmp/
temp/
*.tmp

# --- Reportes de pruebas y cobertura ---
coverage/
.coverage
htmlcov/
.nyc_output/
test-results/
*.lcov


# --- Wrapper de Gradle: SI se versiona ---
# La regla *.jar de arriba lo excluia por error, y sin este archivo el comando
# ./gradlew falla en toda maquina recien clonada con "Unable to access jarfile".
!gradle/wrapper/gradle-wrapper.jar


# --- Cache local de Gradle: NUNCA se versiona ---
# Es estado binario de la maquina de cada quien. Si se versiona, los dieciocho
# ven "modified" en cuanto abren el proyecto y se producen conflictos absurdos.
.gradle/
**/.gradle/

# --- Configuracion de VS Code que SI se comparte ---
# La regla .vscode/* de arriba excluia tambien estos tres, que son el entorno
# comun de la empresa y tienen que llegarle a todo el mundo.
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Guiones locales para lanzar Gradle/Jest/ESLint desde Windows sin bloquear la
# sesion. No son parte del proyecto: CI usa los comandos de package.json y Gradle.
/.correr.ps1
/.jest.ps1
/.front.ps1
/.msg.txt
/.issue.md
/.visual.ps1
/.pr.md

# Capturas del laboratorio visual (UX-R2.1). El informe SI se versiona
# (`INFORME.md` e `informe.json`: son numeros, se comparan entre corridas y
# pesan kilobytes). Las 155 capturas pesan casi 9 MB por corrida y cambian
# enteras con cada ajuste de CSS: versionarlas engordaria el repositorio sin
# darle historia util. Viven como artefacto de `visual.yml`, descargable
# durante 14 dias, que es lo que se adjunta al acta del sprint.
docs/evidencia/ux-r2/**/*.png
