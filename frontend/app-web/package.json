{
  "name": "nexus-battles-app-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interfaz web de The Nexus Battles VI. HTML, CSS y JavaScript sin framework, servida por Spring Boot como recursos estaticos. Este archivo NO construye la aplicacion: solo declara las herramientas de calidad.",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "semi": true,
    "endOfLine": "lf",
    "arrowParens": "always",
    "htmlWhitespaceSensitivity": "css"
  }
}
