    {
      "description": "una reserva de creditos que excede el saldo",
      "providerStates": [
        {
          "name": "el jugador no tiene saldo disponible suficiente"
        }
      ],
      "request": {
        "body": {
          "concepto": "string",
          "jugadorUid": "77777777-0000-0000-0000-0000000000cc",
          "monto": 999999,
          "referenciaId": "aaaaaaaa-0000-0000-0000-000000000001"
        },
        "generators": {
          "body": {
            "$.concepto": {
              "size": 20,
              "type": "RandomString"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json",
          "Idempotency-Key": "\u2E8E\u9388\u671C\u2973\u7079\u9980"
        },
        "matchingRules": {
          "body": {
            "$.concepto": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.jugadorUid": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.monto": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.referenciaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Idempotency-Key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": ".+"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/creditos/reservar"
      },
      "response": {
        "body": {
          "detail": "string",
          "status": 422,
          "type": "https://nexusbattles.upb.edu.co/errors/saldo-insuficiente"
        },
        "generators": {
          "body": {
            "$.detail": {
              "size": 20,
              "type": "RandomString"
            }
          }
        },
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "matchingRules": {
          "body": {
            "$.detail": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 422
      }
    },
