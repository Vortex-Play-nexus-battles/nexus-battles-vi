        }
      ],
      "request": {
        "body": {
          "origen": "MISION",
          "productos": [
            {
              "cantidad": 1,
              "productoId": "4481eb34-384a-3fa0-ba9a-1aac9562c38f"
            }
          ],
          "referencia": "mision-0c7a2d9e-4f8b-4a55-9b65-6f1d3b2f0a11",
          "uid": "5f1c2a7e-3d6b-4b9a-8f0e-1c2d3e4f5a6b"
