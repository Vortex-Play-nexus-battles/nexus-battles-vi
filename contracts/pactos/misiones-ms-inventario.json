    {
      "description": "el bloqueo del heroe al salir a una mision",
      "providerStates": [
        {
          "name": "el heroe es del jugador y esta libre"
        }
      ],
      "request": {
        "body": {
          "ejecucionId": "0c7a2d9e-4f8b-4a55-9b65-6f1d3b2f0a11",
          "propietarioUid": "5f1c2a7e-3d6b-4b9a-8f0e-1c2d3e4f5a6b"
        },
        "headers": {
          "Content-Type": "application/json",
          "Idempotency-Key": "mision-0c7a2d9e-4f8b-4a55-9b65-6f1d3b2f0a11-bloqueo"
        },
        "matchingRules": {
          "body": {
            "$.ejecucionId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.propietarioUid": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          },
          "header": {
            "Idempotency-Key": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": ".+"
                }
              ]
            }
          }
        },
        "method": "PUT",
        "path": "/api/v1/inventario/elementos/heroe-vorn-01/bloqueo-mision"
      },
      "response": {
        "status": 200
      }
    },
