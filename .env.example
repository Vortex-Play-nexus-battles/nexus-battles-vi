# ============================================
# PLANTILLA de variables de entorno.
# Este archivo SI se versiona. Nunca contiene valores reales.
# Copiar a .env en local:  cp .env.example .env
#
# Cada variable de aqui la lee alguien de verdad. Se comprobo una por una
# (R13.4) y se retiraron siete que solo viajaban de `cd.yml` al `.env` del
# host sin que ningun servicio las leyera: DB_NO_RELACIONAL_URL,
# COLA_MENSAJES_URL, SMTP_USER, SMTP_PASSWORD, PASARELA_PAGOS_API_KEY,
# WEBSOCKET_URL y APP_ENV. Una plantilla con variables muertas ensena a
# rellenar cosas que no hacen nada, y esconde las que si importan.
#
# Arquitectura: docs/arquitectura/README.md (dos hosts, no uno).
# ============================================

# --- Entorno ---
LOG_LEVEL=debug

# --- Bases de datos ---
# El motor relacional lo comparten los servicios de plataforma; el de memoria
# lo usa hoy solo moderacion-sanciones.
DB_RELACIONAL_URL=
DB_MEMORIA_URL=
DB_USER=cambiame
DB_PASS=cambiame-en-local

# --- Identidad de usuario (ADR-002) ---
# Clave publica con la que la plataforma verifica los tokens de usuario.
# La publica ms-identidad en /api/v1/auth/jwks.
IDENTIDAD_JWKS_URL=
# Clave privada RSA (PKCS#8 en base64) con la que ms-identidad firma.
# Sin valor, genera un par al arrancar y los tokens no sobreviven al reinicio.
JWT_CLAVE_PRIVADA=

# --- Credenciales de servicio (ADR-001, emisor ADR-005) ---
# Lado emisor (ms-identidad): que servicios pueden pedir credencial y con que
# secreto, "cliente=secreto;otro=secreto" (minimo 16 caracteres cada uno).
# En el despliegue NO viene de un secreto: lo genera scripts/cd/desplegar.sh.
AUTH_CLIENTES_SERVICIO=
# Lado cliente (cada servicio que llama a otro): endpoint de token del emisor
# —http://<ms-identidad>/api/v1/auth/token— y la credencial propia, que tiene
# que estar en AUTH_CLIENTES_SERVICIO.
DIRECTORIO_ACTIVO_URL=
DIRECTORIO_ACTIVO_CLIENT_ID=
DIRECTORIO_ACTIVO_CLIENT_SECRET=

# --- Correo (HU-COR-001) ---
# Solo host y puerto: `correo` no autentica contra el relay en dev (Mailpit no
# lo pide). Por eso no hay SMTP_USER ni SMTP_PASSWORD: no existe
# `spring.mail.username` en su application.yml.
SMTP_HOST=
SMTP_PORT=

# --- Salas de batalla (HU-SAL-002, canal en tiempo real) ---
SALAS_WS_ENDPOINT=
SALAS_WS_ORIGENES=

# --- Verificacion de heroe (HU-SAL-003) ---
# Base del servicio de inventario, que vive en el host de contenido. Mismo
# nombre que usa ms-subastas contra el mismo proveedor: un valor por entorno.
INVENTARIO_BASE_URL=

# --- Lista negra de terminos (HU-ADM-002) ---
# La consumen tres servicios: salas-partidas (chat), comentarios y torneos
# (nombres de equipo). Un solo valor para los tres.
LISTA_NEGRA_VERIFICAR_URL=

# --- Chat de salas (HU-JUE-015) ---
CHAT_WS_ORIGENES=
CHAT_HISTORIAL_TAMANO=

# --- Notificaciones (HU-NOT-006) ---
NOTIFICACIONES_WS_ENDPOINT=
NOTIFICACIONES_WS_ORIGENES=

# --- Comentarios (HU-COM-001) ---
COMENTARIOS_FORMATOS_IMAGEN=

# --- Parametros dinamicos (HU-ADM-001) ---
# Base de admin-parametros. Vacia = el servicio no consulta el catalogo y usa
# sus respaldos de entorno. Una caida de admin-parametros NUNCA tumba a nadie:
# ver docs/gobierno/PARAMETROS-DINAMICOS.md.
PARAMETROS_URL=

# --- Rendimiento (k6, tests/rendimiento/) ---
# Credenciales de la cuenta con la que k6 mide. En CI son secretos del
# repositorio; en local, una cuenta de prueba tuya.
BASE_URL=
K6_USUARIO=
K6_CLAVE=

# ============================================
# Lo que escribe el despliegue y NO se rellena aqui
# ============================================
# `scripts/cd/desplegar.sh` genera estas en el `.env` del host a partir de
# secretos de GitHub Actions. Se listan para que se sepa que existen, no para
# copiarlas: en local no hacen falta salvo que levantes esos servicios.
#
#   MS_IDENTIDAD_DB_URL, MS_IDENTIDAD_DB_USER, MS_IDENTIDAD_DB_PASSWORD
#   MS_IDENTIDAD_SPRING_PROFILES_ACTIVE
#   LISTA_NEGRA_URL
#   MS_CUMPLIMIENTO_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   MS_ECOMMERCE_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   MS_FINANZAS_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   MS_SUBASTAS_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   IDENTIDAD_CORS_ORIGENES
#   SECRETO_SERVICIO_<CLIENTE>  y  AUTH_CLIENTES_SERVICIO
#
# Los nombres exactos que exige cada servicio estan en
# infrastructure/despliegue/servicios.json, que es el catalogo que leen tanto
# cd.yml como desplegar.sh. Las dos ultimas no vienen de ningun secret:
# desplegar.sh las genera en el host la primera vez y las persiste en
# secretos-servicios.env, para que el emisor y cada cliente compartan el mismo
# valor entre despliegues.
#
# OJO con DIRECTORIO_ACTIVO_URL, y la leccion que dejo. Bajo ADR-005 el emisor
# es ms-identidad, no Keycloak, y desplegar.sh lo impone: corrige el archivo
# .env Y exporta la variable al shell. Hacen falta las dos cosas, porque
# Compose resuelve la misma variable en dos sitios distintos:
#
#   env_file: [.env]                  -> lee el ARCHIVO
#   environment: X: ${X:-por_omision} -> INTERPOLA, y ahi gana el shell
#
# Corregir solo el archivo arreglaba nada mas la mitad de los servicios: los
# cuatro que declaran la variable en "environment:" siguieron pidiendole el
# token a un Keycloak inexistente durante semanas, sin caerse, porque fallan
# hacia el lado abierto.
