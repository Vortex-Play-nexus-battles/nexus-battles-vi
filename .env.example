# ============================================
# PLANTILLA de variables de entorno.
# Este archivo SI se versiona. Nunca contiene valores reales.
# Copiar a .env en local:  cp .env.example .env
#
# Cada variable de aqui la lee alguien de verdad. Se comprobo una por una
# (R13.4) y se retiraron siete que solo viajaban de `cd.yml` al `.env` del
# host sin que ningun servicio las leyera: DB_NO_RELACIONAL_URL,
# COLA_MENSAJES_URL, PASARELA_PAGOS_API_KEY,
# WEBSOCKET_URL y APP_ENV. Una plantilla con variables muertas ensena a
# rellenar cosas que no hacen nada, y esconde las que si importan.
#
# Arquitectura: docs/arquitectura/README.md (dos hosts, no uno).
# ============================================

# --- Entorno ---
LOG_LEVEL=debug

# --- Bases de datos ---
# El motor relacional lo comparten los servicios de plataforma; el de memoria
# lo usa hoy solo moderacion-sanciones.
DB_RELACIONAL_URL=
DB_MEMORIA_URL=
DB_USER=cambiame
DB_PASS=cambiame-en-local

# --- Identidad de usuario (ADR-002) ---
# Clave publica con la que la plataforma verifica los tokens de usuario.
# La publica ms-identidad en /api/v1/auth/jwks.
IDENTIDAD_JWKS_URL=
# Clave privada RSA (PKCS#8 en base64) con la que ms-identidad firma.
# Sin valor, genera un par al arrancar y los tokens no sobreviven al reinicio.
JWT_CLAVE_PRIVADA=

# --- Credenciales de servicio (ADR-001, emisor ADR-005) ---
# Lado emisor (ms-identidad): que servicios pueden pedir credencial y con que
# secreto, "cliente=secreto;otro=secreto" (minimo 16 caracteres cada uno).
# En el despliegue NO viene de un secreto: lo genera scripts/cd/desplegar.sh.
AUTH_CLIENTES_SERVICIO=
# Lado cliente (cada servicio que llama a otro): endpoint de token del emisor
# —http://<ms-identidad>/api/v1/auth/token— y la credencial propia, que tiene
# que estar en AUTH_CLIENTES_SERVICIO.
DIRECTORIO_ACTIVO_URL=
DIRECTORIO_ACTIVO_CLIENT_ID=
DIRECTORIO_ACTIVO_CLIENT_SECRET=

# --- Correo (HU-COR-001, RF-COR-001) ---
# Hasta R18 aqui solo habia host y puerto, porque `correo` no tenia
# `spring.mail.username`: no podia autenticar contra ningun proveedor y solo
# servia para hablar con Mailpit (puerto 1025), que recoge los mensajes y no
# los reenvia a nadie. Los correos salian bien y no llegaban a ninguna bandeja.
#
# Vacios = comportamiento de siempre (buzon de pruebas local, sin autenticar).
# Con valor = entrega por un proveedor real.
SMTP_HOST=
SMTP_PORT=
# Credenciales del proveedor. NUNCA en git: van por secret del entorno.
# Se reutilizan los nombres que los secrets de dev ya tenian desde antes de
# R13.4, cuando se retiraron de aqui por estar muertos: lo estaban porque el
# servicio no las leia, no porque sobraran.
SMTP_USER=
SMTP_PASSWORD=
# Las dos en `true` para cualquier proveedor real. STARTTLS se exige, no solo
# se ofrece: si no, una negociacion fallida manda la clave en claro.
SMTP_AUTENTICA=
SMTP_TLS=
# El From tiene que ser una direccion que la cuenta del proveedor tenga
# autorizada. Un From no autorizado es la causa mas comun de un correo que
# "se envio" y nadie recibio. Acepta "Nombre <correo>". Vacio = una direccion
# del dominio reservado .test, que ningun proveedor real entrega (B1: antes
# se llamaba CORREO_REMITENTE).
MAIL_FROM=
CORREO_RESPONDER_A=
# Base publica para los enlaces de los correos (verificar la cuenta,
# restablecer la contrasena). Nunca una IP: los correos ya enviados seguirian
# apuntando a la direccion vieja cuando el entorno cambie.
PUBLIC_BASE_URL=
# Cola persistente del correo (B1). Opcionales; sin ellas valen:
#   CORREO_ENTREGA_INTERVALO_MS=2000   CORREO_ENTREGA_LOTE=10
#   CORREO_MAX_INTENTOS=8              CORREO_REINTENTOS_ESPERAS=30s,1m,2m,5m,15m,30m,1h
#   CORREO_ATASCADO_TRAS=5m            CORREO_RETENCION_DIAS=30
#   CORREO_DB_ESPERA_MS=3000 (espera por una conexion antes de responder 503)

# --- Salas de batalla (HU-SAL-002, canal en tiempo real) ---
SALAS_WS_ENDPOINT=
SALAS_WS_ORIGENES=

# --- Verificacion de heroe (HU-SAL-003) ---
# Base del servicio de inventario, que vive en el host de contenido. Mismo
# nombre que usa ms-subastas contra el mismo proveedor: un valor por entorno.
INVENTARIO_BASE_URL=

# --- Lista negra de terminos (HU-ADM-002) ---
# La consumen tres servicios: salas-partidas (chat), comentarios y torneos
# (nombres de equipo). Un solo valor para los tres.
LISTA_NEGRA_VERIFICAR_URL=

# --- Sanciones unificadas (7.3.2, moderacion-sanciones) ---
# Cada suspension, baneo, reversion o levantamiento se proyecta sobre la cuenta
# en ms-identidad y se avisa por correo, con la credencial DIRECTORIO_ACTIVO_*
# de arriba. Bases SIN /api/v1: la ruta ya lo lleva. Vacias, el compose usa
# srv-ms-identidad:8089 y srv-correo:8082.
IDENTIDAD_URL=
CORREO_URL=

# --- Chat de salas (HU-JUE-015) ---
CHAT_WS_ORIGENES=
CHAT_HISTORIAL_TAMANO=

# --- Mensajes privados (B6, feedback del profesor) ---
# salas-partidas comprueba en ms-identidad que el destinatario existe y esta
# activo (base SIN /api/v1: la ruta del contrato ya lo lleva) y avisa en la
# bandeja de notificaciones (base CON /api/v1) a quien no esta conectado. Las
# dos con la credencial de servicio DIRECTORIO_ACTIVO_* del propio servicio.
# IDENTIDAD_URL es la misma que usa moderacion-sanciones desde B2.
IDENTIDAD_URL=
NOTIFICACIONES_URL=
# Limite de frecuencia por remitente. PROVISIONAL (decision del PO pendiente):
# 5 mensajes cada 10 s si se dejan vacias.
MENSAJES_DIRECTOS_LIMITE_MENSAJES=
MENSAJES_DIRECTOS_LIMITE_VENTANA_SEGUNDOS=
# Cuanto se recuerda que un destinatario existe (30 s si se deja vacia).
MENSAJES_DIRECTOS_IDENTIDAD_CACHE_SEGUNDOS=

# --- Notificaciones (HU-NOT-006) ---
NOTIFICACIONES_WS_ENDPOINT=
NOTIFICACIONES_WS_ORIGENES=

# --- Comentarios (HU-COM-001) ---
# Formatos de imagen admitidos: un subconjunto de jpg, png y webp (contrato
# comentarios 1.4.0); vacio = los tres.
COMENTARIOS_FORMATOS_IMAGEN=
# B3: base del catalogo de productos (sin /api/v1: el servicio anade la ruta).
# Comentar y calificar comprueban ahi que el producto exista. Vacio = en local,
# el 8103 del host (compose de contenido); en AWS lo fija docker-compose.deploy.yml.
PRODUCTOS_URL=

# --- Parametros dinamicos (HU-ADM-001) ---
# Base de admin-parametros. Vacia = el servicio no consulta el catalogo y usa
# sus respaldos de entorno. Una caida de admin-parametros NUNCA tumba a nadie:
# ver docs/gobierno/PARAMETROS-DINAMICOS.md.
PARAMETROS_URL=

# --- Alta del jugador (R17): creditos y heroe iniciales ---
# ms-identidad reutiliza PARAMETROS_URL e INVENTARIO_BASE_URL (arriba); ademas
# habla con ms-finanzas y con el catalogo. Mismos nombres que salas-partidas.
CREDITOS_URL=
PRODUCTOS_BASE_URL=
# Respaldo PROVISIONAL de desarrollo: solo se usa mientras
# `jugador.creditos-iniciales` y `jugador.kit-inicial` no tengan valor en
# admin-parametros (decision del PO pendiente: D-28 y D-29). Vacio = el paso
# del alta queda pendiente y lo dice; nunca se inventa una cifra. El kit son
# ids de producto separados por comas: un heroe y al menos algo equipable.
JUGADOR_CREDITOS_INICIALES=
JUGADOR_KIT_INICIAL=
# Opcionales: segundo-plano (por omision) | sincrona | manual, y cada cuanto
# se reintentan las altas a medias (30000 ms por omision).
ONBOARDING_EJECUCION=
ONBOARDING_INTERVALO_REINTENTOS_MS=

# --- Torneos (B10, torneos.yaml 1.2.0) ---
# Reutiliza CREDITOS_URL, LISTA_NEGRA_VERIFICAR_URL e INVENTARIO_BASE_URL
# (arriba). Bandeja de notificaciones para los avisos de los hitos (base
# /api/v1; mismo nombre que usan comentarios y ms-cumplimiento).
NOTIFICACIONES_URL=
# Premio del campeon por integrante (RF-TOR-007). Vacias = los valores
# PROVISIONALES de application.yml (D-24: 100 creditos y la epica
# «Golpe de defensa»). 0 y vacia = sin premio.
TORNEOS_PREMIO_CREDITOS_POR_INTEGRANTE=
TORNEOS_PREMIO_EPICA_PRODUCTO_ID=
# Correo de los hitos: base de ms-identidad SIN /api/v1 (contacto por uid) y
# base /api/v1 de correo (/correos/torneo, servido desde correo.yaml 1.5.0).
# Vacias = solo bandeja. Opcionales: el documento no pide correos de torneo.
TORNEOS_IDENTIDAD_URL=
TORNEOS_CORREO_URL=
# Cada cuanto se reintentan cobros, devoluciones, premios y avisos (ms), y
# cuanto los espera la propia peticion antes de dejarselos a la tarea (ms).
TORNEOS_OPERACIONES_INTERVALO_MS=
TORNEOS_OPERACIONES_PRESUPUESTO_SINCRONO_MS=

# --- Sanciones unificadas (BACKEND-02, B2) ---
# Base /api/v1 de moderacion-sanciones, a la que ms-identidad delega las
# sanciones del panel. Vacia = srv-moderacion-sanciones:8086 (red de compose).
SANCIONES_URL=

# --- Chatbot (HU-CHA-008): consultas asistidas en vivo ---
# ms-chatbot reutiliza INVENTARIO_BASE_URL, IDENTIDAD_JWKS_URL y
# LISTA_NEGRA_VERIFICAR_URL (arriba). Base /api/v1 de cada servicio; mismos
# nombres que usa ms-subastas.
SUBASTAS_BASE_URL=
NOTIFICACIONES_BASE_URL=
# B11 (ms-chatbot.yaml 2.0.0): movimientos de creditos (con el token del
# jugador) y torneos (dato publico).
FINANZAS_BASE_URL=
TORNEOS_BASE_URL=
# Vacias = valores PROVISIONALES de application.properties (20 mensajes/min por
# jugador o sesion, 10 sesiones/min por origen, 300 en total; 1 s / 1,5 s de
# espera; sesion de visitante de 24 h; RECHAZAR si la lista negra no responde).
CHATBOT_LIMITE_MENSAJES_POR_MINUTO=
CHATBOT_LIMITE_SESIONES_POR_ORIGEN=
CHATBOT_LIMITE_SESIONES_GLOBAL=
CHATBOT_HTTP_TIMEOUT_CONEXION_MS=
CHATBOT_HTTP_TIMEOUT_LECTURA_MS=
CHATBOT_SESION_ANONIMA_HORAS=
CHATBOT_MODERACION_SI_NO_RESPONDE=

# --- Rendimiento (k6, tests/rendimiento/) ---
# Credenciales de la cuenta con la que k6 mide. En CI son secretos del
# repositorio; en local, una cuenta de prueba tuya.
BASE_URL=
K6_USUARIO=
K6_CLAVE=

# ============================================
# Lo que escribe el despliegue y NO se rellena aqui
# ============================================
# `scripts/cd/desplegar.sh` genera estas en el `.env` del host a partir de
# secretos de GitHub Actions. Se listan para que se sepa que existen, no para
# copiarlas: en local no hacen falta salvo que levantes esos servicios.
#
#   MS_IDENTIDAD_DB_URL, MS_IDENTIDAD_DB_USER, MS_IDENTIDAD_DB_PASSWORD
#   MS_IDENTIDAD_SPRING_PROFILES_ACTIVE
#   LISTA_NEGRA_URL
#   MS_CUMPLIMIENTO_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   MS_ECOMMERCE_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   MS_FINANZAS_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   MS_SUBASTAS_DB_{HOST,PORT,NAME,USER,PASSWORD}
#   IDENTIDAD_CORS_ORIGENES
#   SECRETO_SERVICIO_<CLIENTE>  y  AUTH_CLIENTES_SERVICIO
#
# Los nombres exactos que exige cada servicio estan en
# infrastructure/despliegue/servicios.json, que es el catalogo que leen tanto
# cd.yml como desplegar.sh. Las dos ultimas no vienen de ningun secret:
# desplegar.sh las genera en el host la primera vez y las persiste en
# secretos-servicios.env, para que el emisor y cada cliente compartan el mismo
# valor entre despliegues.
#
# OJO con DIRECTORIO_ACTIVO_URL, y la leccion que dejo. Bajo ADR-005 el emisor
# es ms-identidad, no Keycloak, y desplegar.sh lo impone: corrige el archivo
# .env Y exporta la variable al shell. Hacen falta las dos cosas, porque
# Compose resuelve la misma variable en dos sitios distintos:
#
#   env_file: [.env]                  -> lee el ARCHIVO
#   environment: X: ${X:-por_omision} -> INTERPOLA, y ahi gana el shell
#
# Corregir solo el archivo arreglaba nada mas la mitad de los servicios: los
# cuatro que declaran la variable en "environment:" siguieron pidiendole el
# token a un Keycloak inexistente durante semanas, sin caerse, porque fallan
# hacia el lado abierto.
